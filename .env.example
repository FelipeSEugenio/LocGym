# Valores de desenvolvimento local. Copie para .env (que não é versionado).
POSTGRES_DB=locgym
POSTGRES_USER=locgym
POSTGRES_PASSWORD=locgym
# Papel com que a aplicação conecta ao banco (criado pelas migrations; sem BYPASSRLS).
DB_APP_USER=locgym_app
DB_APP_PASSWORD=locgym_app
# Chave RSA que assina os tokens (PEM PKCS#8, uma linha com \n ou o bloco entre aspas).
# Vazia: o backend gera uma chave temporária a cada subida (sessões caem ao reiniciar).
# Gerar: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_CHAVE_PRIVADA=
# Chave HMAC do QR de check-in (Base64 de 32 bytes: openssl rand -base64 32). Vazia: temporária a cada subida.
CHECKIN_CHAVE_QR=
